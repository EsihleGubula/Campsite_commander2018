<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A1C"
    android:gravity="center"
    android:padding="24dp"
    android:orientation="vertical">
    <!-- HEADER BLOCK -->
<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Campsite Commander Inventory"
        android:textColor="#A2C5A4"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <!-- SUMMARY COUNTER CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#253B27"
        android:padding="20dp"
        android:layout_marginTop="32dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Items Packed"
            android:textColor="#A2C5A4"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Counter display for the loops later -->
        <TextView
            android:id="@+id/txtTotalItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />
    </>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ACTION BUTTONS -->
    <Button
        android:id="@+id/btnGoToAddGear"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Add Gear"
        android:textColor="#1B2A1C"
        android:backgroundTint="#A2C5A4"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnViewDetails"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="View Detailed List"
        android:textColor="#FFFFFF"
        android:backgroundTint="#253B27"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />


</LinearLayout>