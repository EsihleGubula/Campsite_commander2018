<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2A1C"
    android:gravity="center"
    android:padding="24dp"
    android:orientation="vertical">

    <!-- HORIZONTAL ROW : This puts the loho and title next to each other -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Logo Emoji on thhe left -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛺ "
            android:textSize="45sp"
            tools:ignore="HardcodedText" />

        <!-- App Title on the right with a left margin to space it out -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text= " Campsite Commander "
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginLeft="12dp"
            tools:ignore="HardcodedText,RtlHardcoded" />

    </LinearLayout>

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading Adventure ... "
            android:textColour = "#A2C5A4"
            android:textSize = "16sp"
            android:layout_marginTop="24dp"
            android:letterSpacing = "0.1"
                tools:ignore="HardcodedText" />
</LinearLayout>



